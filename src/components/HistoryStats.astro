---
/**
 * HistoryStats — the headline numbers for a domain's archived history.
 *
 * Wording matters more than the arithmetic here. Every figure describes what
 * the Internet Archive *holds*, which is not the same as the website's real
 * history: a site can long predate its first capture, coverage is uneven, and
 * the Archive excludes some domains entirely. So the labels say "first archived
 * snapshot found", never "launched", and the coverage figure is presented as
 * the archive's completeness rather than the site's activity.
 */
import type { ArchiveOverview, HistoryStats } from '@lib/types';
import { formatCount, formatCoverage, monthLabel } from '@lib/history';
import { formatISODate } from '@utils/date';

interface Props {
  stats: HistoryStats;
  overview: ArchiveOverview;
  /** How many representative snapshots the timeline is plotting. */
  representativeCount?: number;
  /** Years the archiving-spike heuristic flagged. */
  spikeYears?: number[];
}

const {
  stats,
  overview,
  representativeCount = 0,
  spikeYears = [],
} = Astro.props;

const hasHistory = overview.status === 'ok' && stats.firstArchivedDate;

/* The primary tiles. Kept to four so the row reads at a glance on desktop and
   stacks to a clean 2×2 on mobile. */
const tiles = hasHistory
  ? [
      {
        label: 'First archived snapshot found',
        value: String(stats.firstYear),
        detail: stats.firstArchivedDate
          ? formatISODate(stats.firstArchivedDate)
          : null,
      },
      {
        label: 'Latest archived snapshot',
        value: String(stats.lastYear),
        detail: stats.lastArchivedDate
          ? formatISODate(stats.lastArchivedDate)
          : null,
      },
      {
        label: 'Years of archived history',
        value: String(stats.yearsSpanned),
        detail: `${stats.yearsWithCaptures} years hold captures`,
      },
      {
        label: 'Captures on record',
        value: formatCount(stats.totalCaptures),
        detail: 'as counted by the Internet Archive',
      },
    ]
  : [];

/* Secondary facts — real but less headline-worthy. */
const details = hasHistory
  ? [
      {
        term: 'Archive coverage',
        value: `${formatCoverage(stats.coverage)} of months`,
        note: `${formatCount(stats.monthsWithCaptures)} of ${formatCount(stats.monthsInSpan)} months between the first and latest capture hold at least one snapshot.`,
      },
      {
        term: 'Representative snapshots',
        value: formatCount(representativeCount),
        note: 'Points spread evenly across the history, chosen so the timeline stays fast and readable.',
      },
      stats.busiestMonth
        ? {
            term: 'Most-archived month',
            value: monthLabel(
              stats.busiestMonth.year,
              stats.busiestMonth.month
            ),
            note: `${formatCount(stats.busiestMonth.captures)} captures — usually a sign of heavy crawling rather than a busy website.`,
          }
        : null,
      spikeYears.length
        ? {
            term: 'Years worth a look',
            value: spikeYears.join(', '),
            note: 'Archiving activity jumped well above the surrounding years. That often coincides with a relaunch, but it measures crawl volume, not the page itself.',
          }
        : null,
    ].filter(
      (d): d is { term: string; value: string; note: string } => d !== null
    )
  : [];
---

{
  hasHistory ? (
    <section aria-label="Archived history summary">
      <dl class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {tiles.map((tile) => (
          <div class="card p-4 sm:p-5">
            <dt class="text-xs font-medium text-neutral-500">{tile.label}</dt>
            <dd class="mt-1 text-2xl font-semibold tracking-tight text-neutral-900 tabular-nums sm:text-3xl dark:text-neutral-100">
              {tile.value}
            </dd>
            {tile.detail && (
              <p class="mt-0.5 text-xs text-neutral-500">{tile.detail}</p>
            )}
          </div>
        ))}
      </dl>

      {details.length > 0 && (
        <dl class="mt-4 grid gap-x-8 gap-y-3 rounded-xl border border-neutral-200 bg-neutral-50 p-5 text-sm sm:grid-cols-2 dark:border-neutral-800 dark:bg-neutral-900/40">
          {details.map((d) => (
            <div>
              <dt class="font-medium text-neutral-900 dark:text-neutral-100">
                {d.term}
                <span class="ml-2 font-normal text-neutral-600 tabular-nums dark:text-neutral-400">
                  {d.value}
                </span>
              </dt>
              <dd class="mt-0.5 text-xs text-neutral-500">{d.note}</dd>
            </div>
          ))}
        </dl>
      )}

      <p class="mt-3 text-xs text-neutral-500">
        These figures describe what the Internet Archive holds for{' '}
        <strong class="font-medium">{stats.domain}</strong> — not the website's
        own history. A site can be older than its first capture, and the archive
        does not cover every day.
      </p>
    </section>
  ) : (
    <section
      class="rounded-xl border border-neutral-200 bg-neutral-50 p-5 text-sm text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900/40 dark:text-neutral-400"
      aria-label="Archived history summary unavailable"
    >
      {overview.message ??
        'No archived history statistics are available for this website.'}
    </section>
  )
}
