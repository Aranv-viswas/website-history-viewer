---
/**
 * HistoryTimeline — the horizontal, proportional timeline of a domain's
 * archived history.
 *
 * Design decisions worth knowing:
 *
 * - **Proportional, not per-entry.** Every element is positioned by its real
 *   offset in time, so a 1998-2003 gap is visibly a gap. A list of "the years
 *   we happen to have" would quietly hide the archive's holes.
 *
 * - **Density on a log scale.** Crawl volume spans six orders of magnitude
 *   (Google: 6 captures in 1998, 2.6M in one month of 2022). On a linear scale
 *   every year before ~2010 would render as a zero-height sliver, so the bars
 *   use log1p, which keeps the early web legible while still showing growth.
 *
 * - **Representative markers, not every capture.** A domain can hold millions
 *   of captures; we plot the representative set chosen by
 *   `pickRepresentativeMonths` (typically 12-32 points). Everything else is
 *   summarized by the density bars behind them.
 *
 * - **Server-rendered.** The overview endpoint answers in well under a second,
 *   so the whole timeline ships in the HTML: it works with JavaScript disabled
 *   (markers are plain links), it's crawlable, and there's no loading flash.
 *   JS only adds zoom, keyboard navigation and the hover tooltip.
 */
import type { ArchiveOverview, EvolutionFrame } from '@lib/types';
import { groupByYear, monthLabel, formatCount } from '@lib/history';
import { domainToSlug } from '@utils/domain';

interface Props {
  overview: ArchiveOverview;
  /** The representative points to plot as clickable markers. */
  frames: EvolutionFrame[];
  /** ISO date of the currently-open snapshot, if any, to highlight. */
  selectedDate?: string | null;
  /** Years flagged by the archiving-spike heuristic, marked on the axis. */
  spikeYears?: number[];
  /** Where a marker links to. 'site' opens the viewer; 'evolution' jumps the player. */
  linkMode?: 'site' | 'none';
}

const {
  overview,
  frames,
  selectedDate = null,
  spikeYears = [],
  linkMode = 'site',
} = Astro.props;

const slug = domainToSlug(overview.domain);
const years = groupByYear(overview.months);

/* Absolute month index math. Everything on the axis is positioned as a
   percentage of the total span, which is what makes gaps read as gaps. */
const first = overview.months[0];
const last = overview.months[overview.months.length - 1];
const startIndex = first ? first.year * 12 + (first.month - 1) : 0;
const endIndex = last ? last.year * 12 + (last.month - 1) : 0;
const totalMonths = Math.max(1, endIndex - startIndex);

const pct = (year: number, month: number) =>
  ((year * 12 + (month - 1) - startIndex) / totalMonths) * 100;

/* Log-scaled bar heights (see the note above). */
const maxYearly = Math.max(1, ...years.map((y) => y.captures));
const logMax = Math.log1p(maxYearly);
const barHeight = (captures: number) =>
  captures <= 0 ? 0 : Math.max(4, (Math.log1p(captures) / logMax) * 100);

/* Year labels get thinned on narrow spans so they never collide. With a long
   history we label every 5th year plus the two endpoints; short histories get
   every year. The client re-thins on zoom. */
const labelEvery = years.length > 24 ? 5 : years.length > 12 ? 2 : 1;
const isLabelled = (index: number) =>
  index === 0 ||
  index === years.length - 1 ||
  years[index].year % labelEvery === 0;

const spikeSet = new Set(spikeYears);

/* Markers within ~3% of each other would overlap into an unreadable clump, so
   we thin them here rather than letting the browser stack them. The selected
   marker always survives thinning. */
const MIN_GAP_PCT = 2.5;
const plotted: Array<EvolutionFrame & { left: number }> = [];
for (const frame of frames) {
  const left = pct(frame.year, frame.month);
  const selected = selectedDate?.slice(0, 7) === frame.date.slice(0, 7);
  const previous = plotted[plotted.length - 1];
  if (previous && !selected && left - previous.left < MIN_GAP_PCT) continue;
  plotted.push({ ...frame, left });
}

const hasHistory = overview.status === 'ok' && overview.months.length > 0;
---

{
  hasHistory ? (
    <section
      class="not-prose"
      data-timeline
      data-slug={slug}
      aria-label={`Archived capture timeline for ${overview.domain}`}
    >
      {/* ── Toolbar ─────────────────────────────────────────────────────── */}
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          <span class="font-medium text-neutral-900 dark:text-neutral-100">
            {first.year}
          </span>
          <span class="mx-1.5 text-neutral-400" aria-hidden="true">
            —
          </span>
          <span class="font-medium text-neutral-900 dark:text-neutral-100">
            {last.year}
          </span>
          <span class="ml-2 text-neutral-500">
            · {formatCount(overview.totalCaptures)} captures
          </span>
        </p>

        <div
          class="flex items-center gap-1"
          role="group"
          aria-label="Timeline zoom"
        >
          <button
            type="button"
            data-zoom="out"
            class="flex h-8 w-8 items-center justify-center rounded-md border border-neutral-200 text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-40 dark:border-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-800"
            aria-label="Zoom out"
          >
            −
          </button>
          <span
            data-zoom-label
            class="min-w-[3.5rem] text-center font-mono text-xs text-neutral-500"
          >
            1×
          </span>
          <button
            type="button"
            data-zoom="in"
            class="flex h-8 w-8 items-center justify-center rounded-md border border-neutral-200 text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-40 dark:border-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-800"
            aria-label="Zoom in"
          >
            +
          </button>
        </div>
      </div>

      {/* ── The scrolling axis ──────────────────────────────────────────── */}
      <div
        data-timeline-scroller
        tabindex="0"
        role="group"
        aria-label="Scrollable timeline. Use the left and right arrow keys to move between snapshots."
        class="relative overflow-x-auto overflow-y-hidden rounded-xl border border-neutral-200 bg-white px-6 pb-2 pt-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 dark:border-neutral-800 dark:bg-neutral-900"
      >
        <div
          data-timeline-track
          class="relative h-[124px] min-w-full"
          style="width:100%"
        >
          {/* Density bars — one per calendar year, including empty ones. */}
          {years.map((y) => (
            <div
              class="absolute bottom-[38px] flex items-end justify-center"
              style={`left:${pct(y.year, 1)}%;width:${(12 / totalMonths) * 100}%;height:56px`}
              aria-hidden="true"
            >
              <div
                class:list={[
                  'w-full max-w-[26px] rounded-sm transition-colors',
                  y.captures > 0
                    ? 'bg-neutral-200 group-hover:bg-neutral-300 dark:bg-neutral-700'
                    : 'bg-transparent',
                ]}
                style={`height:${barHeight(y.captures)}%`}
                title={`${y.year}: ${formatCount(y.captures)} captures`}
              />
            </div>
          ))}

          {/* The axis line. */}
          <div
            class="absolute right-0 bottom-[36px] left-0 h-px bg-neutral-300 dark:bg-neutral-700"
            aria-hidden="true"
          />

          {/* Year ticks + labels. */}
          {years.map((y, i) => (
            <div
              class="absolute bottom-0"
              style={`left:${pct(y.year, 1)}%`}
              aria-hidden="true"
            >
              <div
                class:list={[
                  'w-px -translate-x-1/2',
                  isLabelled(i)
                    ? 'h-2 bg-neutral-400 dark:bg-neutral-600'
                    : 'h-1 bg-neutral-300 dark:bg-neutral-700',
                ]}
                style="margin-bottom:28px"
              />
              {isLabelled(i) && (
                <span
                  data-year-label
                  class:list={[
                    'absolute top-[10px] -translate-x-1/2 font-mono text-[11px] whitespace-nowrap',
                    spikeSet.has(y.year)
                      ? 'font-semibold text-brand-600 dark:text-brand-400'
                      : 'text-neutral-500',
                  ]}
                >
                  {y.year}
                </span>
              )}
            </div>
          ))}

          {/* Representative snapshot markers. */}
          {plotted.map((frame) => {
            const selected =
              selectedDate?.slice(0, 7) === frame.date.slice(0, 7);
            const label = `${monthLabel(frame.year, frame.month)} — ${formatCount(frame.captures)} captures`;
            const inner = (
              <>
                <span
                  class:list={[
                    'block rounded-full border-2 transition-transform duration-150 group-hover:scale-125 group-focus-visible:scale-125',
                    selected
                      ? 'h-4 w-4 border-white bg-brand-600 ring-2 ring-brand-600 dark:border-neutral-900 dark:bg-brand-400 dark:ring-brand-400'
                      : 'h-3 w-3 border-white bg-neutral-900 dark:border-neutral-900 dark:bg-neutral-100',
                  ]}
                />
                <span class="sr-only">{label}</span>
              </>
            );
            const classes =
              'group absolute bottom-[30px] -translate-x-1/2 rounded-full p-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500';
            return linkMode === 'site' ? (
              <a
                href={`/site/${slug}/${frame.date}`}
                data-marker
                data-date={frame.date}
                data-label={label}
                aria-current={selected ? 'true' : undefined}
                class={classes}
                style={`left:${frame.left}%`}
                title={label}
              >
                {inner}
              </a>
            ) : (
              <button
                type="button"
                data-marker
                data-date={frame.date}
                data-label={label}
                aria-current={selected ? 'true' : undefined}
                class={classes}
                style={`left:${frame.left}%`}
                title={label}
              >
                {inner}
              </button>
            );
          })}
        </div>

        {/* Hover/focus tooltip, positioned by the client script. */}
        <div
          data-timeline-tip
          role="status"
          class="pointer-events-none absolute z-20 hidden -translate-x-1/2 rounded-md bg-neutral-900 px-2 py-1 text-[11px] font-medium whitespace-nowrap text-white shadow dark:bg-neutral-100 dark:text-neutral-900"
        />
      </div>

      <p class="mt-2 text-xs text-neutral-500">
        Bars show how many captures the Internet Archive holds each year (log
        scale). Dots are representative snapshots — select one to open it.
      </p>
    </section>
  ) : (
    <section
      class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center dark:border-neutral-700 dark:bg-neutral-900/40"
      aria-label="No timeline available"
    >
      <span class="text-3xl" aria-hidden="true">
        {overview.status === 'blocked' ? '🚫' : '🗄️'}
      </span>
      <p class="mt-3 font-medium text-neutral-800 dark:text-neutral-200">
        {overview.status === 'blocked'
          ? 'This site is excluded from the Wayback Machine'
          : overview.status === 'unavailable'
            ? 'The Internet Archive is not responding'
            : 'No archived captures found'}
      </p>
      <p class="mx-auto mt-1 max-w-md text-sm text-neutral-500">
        {overview.message ??
          'We could not build a timeline for this website. Try another domain.'}
      </p>
    </section>
  )
}

<script>
  /**
   * Timeline interactions: zoom, keyboard navigation, and the hover tooltip.
   * Every one of these is an enhancement — the markers are already links and
   * the axis already renders without this script.
   */
  const ZOOM_STEPS = [1, 1.5, 2, 3, 4, 6, 8];

  function initTimeline(root: HTMLElement) {
    const scroller = root.querySelector<HTMLElement>(
      '[data-timeline-scroller]'
    );
    const track = root.querySelector<HTMLElement>('[data-timeline-track]');
    const tip = root.querySelector<HTMLElement>('[data-timeline-tip]');
    const zoomLabel = root.querySelector<HTMLElement>('[data-zoom-label]');
    if (!scroller || !track) return;

    let zoomIndex = 0;

    function applyZoom(nextIndex: number, anchorRatio?: number) {
      const clamped = Math.min(ZOOM_STEPS.length - 1, Math.max(0, nextIndex));
      if (clamped === zoomIndex) return;

      // Keep whatever the user was looking at under the same screen position
      // instead of snapping back to 1998 on every zoom step.
      const anchor =
        anchorRatio ??
        (scroller!.scrollLeft + scroller!.clientWidth / 2) /
          Math.max(1, track!.scrollWidth);

      zoomIndex = clamped;
      const zoom = ZOOM_STEPS[zoomIndex];
      track!.style.width = `${zoom * 100}%`;
      if (zoomLabel) zoomLabel.textContent = `${zoom}×`;

      // Re-read scrollWidth after the layout change.
      requestAnimationFrame(() => {
        scroller!.scrollLeft =
          anchor * track!.scrollWidth - scroller!.clientWidth / 2;
      });

      root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
        btn.disabled =
          btn.dataset.zoom === 'in'
            ? zoomIndex === ZOOM_STEPS.length - 1
            : zoomIndex === 0;
      });

      // At higher zoom levels there's room for every year label.
      root
        .querySelectorAll<HTMLElement>('[data-year-label]')
        .forEach((el) => el.classList.remove('hidden'));
    }

    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        applyZoom(zoomIndex + (btn.dataset.zoom === 'in' ? 1 : -1));
      });
    });
    applyZoom(0);

    /* Tooltip on hover/focus. */
    const markers = () =>
      Array.from(root.querySelectorAll<HTMLElement>('[data-marker]'));

    function showTip(marker: HTMLElement) {
      if (!tip) return;
      tip.textContent = marker.dataset.label ?? '';
      tip.classList.remove('hidden');
      const markerBox = marker.getBoundingClientRect();
      const scrollBox = scroller!.getBoundingClientRect();
      tip.style.left = `${markerBox.left - scrollBox.left + markerBox.width / 2 + scroller!.scrollLeft}px`;
      tip.style.top = `${markerBox.top - scrollBox.top - 26}px`;
    }
    function hideTip() {
      tip?.classList.add('hidden');
    }

    root.addEventListener('pointerover', (e) => {
      const marker = (e.target as Element)?.closest?.<HTMLElement>(
        '[data-marker]'
      );
      if (marker) showTip(marker);
    });
    root.addEventListener('pointerout', hideTip);
    root.addEventListener('focusin', (e) => {
      const marker = (e.target as Element)?.closest?.<HTMLElement>(
        '[data-marker]'
      );
      if (marker) {
        showTip(marker);
        marker.scrollIntoView({ block: 'nearest', inline: 'center' });
      }
    });
    root.addEventListener('focusout', hideTip);

    /* Arrow keys move along the axis when the scroller itself has focus. */
    scroller.addEventListener('keydown', (e) => {
      if (e.target !== scroller) return;
      const list = markers();
      if (!list.length) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const current = list.findIndex(
          (m) => m.getAttribute('aria-current') === 'true'
        );
        const start = current === -1 ? 0 : current;
        const next = Math.min(
          list.length - 1,
          Math.max(0, start + (e.key === 'ArrowRight' ? 1 : -1))
        );
        list[next].focus();
      }
    });

    // Open the timeline centred on the current selection.
    const selected = root.querySelector<HTMLElement>('[aria-current="true"]');
    selected?.scrollIntoView({ block: 'nearest', inline: 'center' });
  }

  document
    .querySelectorAll<HTMLElement>('[data-timeline]')
    .forEach(initTimeline);
</script>
