---
/**
 * EvolutionPlayer — watch a website transform across its archived history.
 *
 * How it's put together, and why:
 *
 * - **The shell is server-rendered, the playback is not.** Resolving a snapshot
 *   per frame is a fan-out of upstream lookups (see /api/evolution), far too
 *   slow to block a page render. So the markup ships complete — heading,
 *   controls, and a filmstrip of dated links that works with no JavaScript at
 *   all — and the player fetches the resolved sequence once, behind a progress
 *   state, then takes over.
 *
 * - **Only a few frames are ever mounted.** Each frame is an <iframe> onto
 *   web.archive.org. Mounting all of them would mean 16+ simultaneous loads of
 *   a third-party archive. Instead the stage keeps a small sliding window: the
 *   current frame, a lookahead so the next transition is already warm, and one
 *   behind for a backwards step. Everything else is torn down.
 *
 * - **Unavailable frames are kept, not hidden.** A gap in the archive is part
 *   of the history. Playback skips them; the filmstrip still shows them greyed,
 *   so the sequence stays honest about what's missing.
 */
import type { EvolutionFrame } from '@lib/types';
import { domainToSlug } from '@utils/domain';
import FullscreenSupport from '@components/FullscreenSupport.astro';

interface Props {
  domain: string;
  name: string;
  /** The representative frames, unresolved — the client resolves them. */
  frames: EvolutionFrame[];
  /** How many frames to request from /api/evolution. */
  frameCount: number;
}

const { domain, name, frames, frameCount } = Astro.props;
const slug = domainToSlug(domain);

/** Playback speeds, in milliseconds per frame. */
const SPEEDS = [
  { label: '0.5×', ms: 4000 },
  { label: '1×', ms: 2000 },
  { label: '2×', ms: 1000 },
  { label: '4×', ms: 500 },
];
const DEFAULT_SPEED_INDEX = 1;
---

<section
  data-evolution
  data-domain={domain}
  data-slug={slug}
  data-frames={frameCount}
  aria-label={`Evolution playback for ${name}`}
>
  {/* ── Stage ───────────────────────────────────────────────────────────── */}
  <div
    data-stage
    data-fullscreen-target
    class="group relative aspect-[16/10] w-full overflow-hidden rounded-xl border border-neutral-200 bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900"
  >
    {/* Frame panes are inserted here by the client. */}
    <div data-panes class="absolute inset-0"></div>

    {/* Date readout, always over the stage. */}
    <div
      class="pointer-events-none absolute top-3 left-3 z-20 flex flex-col gap-0.5"
    >
      <span
        data-readout-year
        class="font-mono text-3xl leading-none font-semibold text-white drop-shadow-[0_1px_4px_rgba(0,0,0,0.8)] sm:text-5xl"
        >—</span
      >
      <span
        data-readout-date
        class="font-mono text-[11px] text-white/90 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]"
      ></span>
    </div>

    {/* Loading / empty / error state. */}
    <div
      data-stage-status
      class="absolute inset-0 z-30 flex flex-col items-center justify-center gap-3 bg-neutral-100 px-6 text-center dark:bg-neutral-900"
    >
      <div
        data-status-spinner
        class="h-8 w-8 animate-spin rounded-full border-2 border-neutral-300 border-t-brand-600 dark:border-neutral-700 dark:border-t-brand-400"
      >
      </div>
      <p
        data-status-text
        class="text-sm font-medium text-neutral-600 dark:text-neutral-400"
      >
        Preparing {name}'s evolution…
      </p>
      <p data-status-detail class="max-w-sm text-xs text-neutral-500">
        Looking up representative snapshots across the archive. This takes a
        moment the first time.
      </p>
      <button
        type="button"
        data-status-retry
        class="btn-secondary mt-1 hidden !px-4 !py-1.5 !text-xs"
      >
        Try again
      </button>
    </div>

    {/* Fullscreen toggle — reuses the shared handler in ScreenshotFrame. */}
    <button
      type="button"
      data-fullscreen-btn
      title="View fullscreen"
      aria-label="View fullscreen"
      class="absolute right-3 bottom-3 z-20 rounded-md bg-black/55 p-1.5 text-white opacity-0 backdrop-blur-sm transition hover:bg-black/75 focus:opacity-100 focus-visible:outline-none group-hover:opacity-100"
    >
      <svg
        data-fs-icon="enter"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4"
        aria-hidden="true"
      >
        <path
          d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3"
        ></path>
      </svg>
      <svg
        data-fs-icon="exit"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden h-4 w-4"
        aria-hidden="true"
      >
        <path
          d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
        ></path>
      </svg>
    </button>
  </div>

  {/* ── Progress scrubber ───────────────────────────────────────────────── */}
  <div class="mt-4">
    <input
      data-scrubber
      type="range"
      min="0"
      max={Math.max(0, frames.length - 1)}
      value="0"
      step="1"
      disabled
      aria-label="Playback position"
      class="h-1.5 w-full cursor-pointer appearance-none rounded-full bg-neutral-200 accent-neutral-900 disabled:cursor-default disabled:opacity-50 dark:bg-neutral-800 dark:accent-white"
    />
    <div
      class="mt-1.5 flex justify-between font-mono text-[11px] text-neutral-500"
    >
      <span>{frames[0]?.year ?? ''}</span>
      <span data-progress-count></span>
      <span>{frames[frames.length - 1]?.year ?? ''}</span>
    </div>
  </div>

  {/* ── Transport controls ──────────────────────────────────────────────── */}
  <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
    <button
      type="button"
      data-control="prev"
      disabled
      class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-40 dark:border-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-800"
      aria-label="Previous snapshot"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-4 w-4"
        aria-hidden="true"><path d="M6 5h2v14H6zm3.5 7 8.5 6V6z"></path></svg
      >
    </button>

    <button
      type="button"
      data-control="playpause"
      disabled
      class="btn-primary !h-12 !w-12 !p-0"
      aria-label="Play evolution"
      aria-pressed="false"
    >
      <svg
        data-icon="play"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-5 w-5"
        aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg
      >
      <svg
        data-icon="pause"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="hidden h-5 w-5"
        aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"></path></svg
      >
    </button>

    <button
      type="button"
      data-control="next"
      disabled
      class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 text-neutral-700 transition hover:bg-neutral-100 disabled:opacity-40 dark:border-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-800"
      aria-label="Next snapshot"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-4 w-4"
        aria-hidden="true"><path d="M16 5h2v14h-2zM6 18l8.5-6L6 6z"></path></svg
      >
    </button>

    <div
      class="ml-1 flex items-center gap-1 rounded-full border border-neutral-200 p-1 dark:border-neutral-800"
      role="group"
      aria-label="Playback speed"
    >
      {
        SPEEDS.map((speed, i) => (
          <button
            type="button"
            data-speed={speed.ms}
            aria-pressed={i === DEFAULT_SPEED_INDEX ? 'true' : 'false'}
            class:list={[
              'rounded-full px-2.5 py-1 font-mono text-xs transition',
              i === DEFAULT_SPEED_INDEX
                ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900'
                : 'text-neutral-600 hover:bg-neutral-100 dark:text-neutral-400 dark:hover:bg-neutral-800',
            ]}
          >
            {speed.label}
          </button>
        ))
      }
    </div>

    <label
      class="flex cursor-pointer items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400"
    >
      <input
        data-control="loop"
        type="checkbox"
        checked
        class="h-3.5 w-3.5 rounded border-neutral-300 accent-neutral-900 dark:accent-white"
      />
      Loop
    </label>
  </div>

  <p class="mt-3 text-center text-xs text-neutral-500">
    <kbd
      class="rounded border border-neutral-300 px-1 font-mono dark:border-neutral-700"
      >Space</kbd
    > play/pause ·
    <kbd
      class="rounded border border-neutral-300 px-1 font-mono dark:border-neutral-700"
      >←</kbd
    >
    <kbd
      class="rounded border border-neutral-300 px-1 font-mono dark:border-neutral-700"
      >→</kbd
    > step
  </p>

  {
    /* ── Filmstrip ───────────────────────────────────────────────────────────
      Server-rendered, so this is real crawlable content and a working
      no-JavaScript navigation. The client upgrades each item into a seek
      control once playback is ready. */
  }
  <div class="mt-8">
    <h2
      class="mb-3 text-sm font-semibold text-neutral-900 dark:text-neutral-100"
    >
      {frames.length} snapshots in this evolution
    </h2>
    <ol
      data-filmstrip
      class="flex snap-x gap-2 overflow-x-auto pb-3"
      aria-label="Evolution frames"
    >
      {
        frames.map((frame, i) => (
          <li class="shrink-0 snap-start">
            <a
              href={`/site/${slug}/${frame.date}`}
              data-film-item
              data-index={i}
              class="flex min-w-[76px] flex-col items-center gap-0.5 rounded-lg border border-neutral-200 bg-white px-3 py-2 font-mono text-[11px] text-neutral-600 transition hover:border-neutral-300 aria-[current=true]:border-brand-500 aria-[current=true]:bg-brand-50 aria-[current=true]:font-semibold aria-[current=true]:text-brand-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400 dark:aria-[current=true]:bg-brand-950 dark:aria-[current=true]:text-brand-300"
            >
              <span class="text-neutral-900 dark:text-neutral-100">
                {frame.year}
              </span>
              <span>{frame.label.slice(0, 3)}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<FullscreenSupport />

<script>
  /**
   * Evolution playback controller.
   *
   * State is deliberately tiny: an index into the resolved frame list, a timer,
   * and a set of mounted panes. Everything visible is derived from those.
   */
  interface PlayableFrame {
    year: number;
    month: number;
    date: string;
    label: string;
    available: boolean;
    capturedAt: string | null;
    archivedUrl: string | null;
    embedUrl: string | null;
  }

  interface EvolutionPayload {
    status: string;
    message: string | null;
    name?: string;
    frames?: PlayableFrame[];
    playableCount?: number;
  }

  /** Frames kept mounted around the current one: [behind, ahead]. */
  const WINDOW_BEHIND = 1;
  const WINDOW_AHEAD = 2;

  function initPlayer(root: HTMLElement) {
    const panes = root.querySelector<HTMLElement>('[data-panes]');
    const status = root.querySelector<HTMLElement>('[data-stage-status]');
    const statusText = root.querySelector<HTMLElement>('[data-status-text]');
    const statusDetail = root.querySelector<HTMLElement>(
      '[data-status-detail]'
    );
    const statusSpinner = root.querySelector<HTMLElement>(
      '[data-status-spinner]'
    );
    const statusRetry = root.querySelector<HTMLButtonElement>(
      '[data-status-retry]'
    );
    const readoutYear = root.querySelector<HTMLElement>('[data-readout-year]');
    const readoutDate = root.querySelector<HTMLElement>('[data-readout-date]');
    const scrubber = root.querySelector<HTMLInputElement>('[data-scrubber]');
    const progressCount = root.querySelector<HTMLElement>(
      '[data-progress-count]'
    );
    const playBtn = root.querySelector<HTMLButtonElement>(
      '[data-control="playpause"]'
    );
    const prevBtn = root.querySelector<HTMLButtonElement>(
      '[data-control="prev"]'
    );
    const nextBtn = root.querySelector<HTMLButtonElement>(
      '[data-control="next"]'
    );
    const loopBox = root.querySelector<HTMLInputElement>(
      '[data-control="loop"]'
    );
    const filmItems = Array.from(
      root.querySelectorAll<HTMLAnchorElement>('[data-film-item]')
    );

    if (!panes) return;

    let frames: PlayableFrame[] = [];
    /** Indices of frames that actually have something to show. */
    let playable: number[] = [];
    let index = 0;
    let timer: number | null = null;
    let speedMs = 2000;
    const mounted = new Map<number, HTMLElement>();

    /* ── Status helpers ─────────────────────────────────────────────── */

    function showStatus(text: string, detail: string, retry: boolean) {
      if (!status) return;
      status.classList.remove('hidden');
      statusSpinner?.classList.toggle('hidden', retry);
      if (statusText) statusText.textContent = text;
      if (statusDetail) statusDetail.textContent = detail;
      statusRetry?.classList.toggle('hidden', !retry);
    }

    function hideStatus() {
      status?.classList.add('hidden');
    }

    /* ── Pane mounting ──────────────────────────────────────────────── */

    function mount(i: number): HTMLElement | null {
      const existing = mounted.get(i);
      if (existing) return existing;

      const frame = frames[i];
      if (!frame?.embedUrl) return null;

      const pane = document.createElement('div');
      pane.className =
        'absolute inset-0 opacity-0 transition-opacity duration-500 motion-reduce:transition-none';
      pane.dataset.pane = String(i);

      const iframe = document.createElement('iframe');
      iframe.src = frame.embedUrl;
      iframe.title = `${frame.label} snapshot`;
      iframe.referrerPolicy = 'no-referrer';
      iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
      // The stage is a playback surface; scroll and clicks belong to the page.
      iframe.className = 'pointer-events-none h-full w-full border-0 bg-white';
      pane.appendChild(iframe);

      panes!.appendChild(pane);
      mounted.set(i, pane);
      return pane;
    }

    /** Tear down panes outside the sliding window, freeing their loads. */
    function prune() {
      for (const [i, pane] of mounted) {
        if (i < index - WINDOW_BEHIND || i > index + WINDOW_AHEAD) {
          pane.remove();
          mounted.delete(i);
        }
      }
    }

    /* ── Rendering ──────────────────────────────────────────────────── */

    function render() {
      const frame = frames[index];
      if (!frame) return;

      // Mount the current frame plus the lookahead, so the next transition is
      // already loaded when it happens.
      mount(index);
      for (let ahead = 1; ahead <= WINDOW_AHEAD; ahead += 1) {
        mount(index + ahead);
      }
      prune();

      for (const [i, pane] of mounted) {
        pane.style.opacity = i === index ? '1' : '0';
        pane.style.zIndex = i === index ? '10' : '1';
      }

      if (readoutYear) readoutYear.textContent = String(frame.year);
      if (readoutDate) {
        readoutDate.textContent = frame.available
          ? `${frame.label}${frame.capturedAt ? ` · captured ${frame.capturedAt}` : ''}`
          : `${frame.label} · no capture found`;
      }

      if (scrubber) scrubber.value = String(index);
      if (progressCount) {
        progressCount.textContent = `${index + 1} / ${frames.length}`;
      }

      filmItems.forEach((item, i) => {
        item.setAttribute('aria-current', i === index ? 'true' : 'false');
        if (i === index) {
          item.scrollIntoView({ block: 'nearest', inline: 'center' });
        }
      });

      // A frame with no capture has nothing to fade to, so say so on the stage
      // rather than showing the previous frame and implying it's this year's.
      if (!frame.available) {
        showStatus(
          'No capture for this date',
          `The Internet Archive has no usable snapshot near ${frame.label}. Playback continues to the next one.`,
          false
        );
        statusSpinner?.classList.add('hidden');
      } else {
        hideStatus();
      }
    }

    /* ── Navigation ─────────────────────────────────────────────────── */

    /** Step to the next playable frame, or the next frame if none are left. */
    function step(delta: number): boolean {
      if (frames.length === 0) return false;
      let next = index + delta;

      // Skip over gaps so playback doesn't stall on missing captures.
      while (next >= 0 && next < frames.length && !frames[next].available) {
        next += delta;
      }

      if (next < 0 || next >= frames.length) {
        if (!loopBox?.checked) return false;
        next =
          delta > 0 ? (playable[0] ?? 0) : (playable[playable.length - 1] ?? 0);
      }

      index = next;
      render();
      return true;
    }

    function seek(target: number) {
      index = Math.min(frames.length - 1, Math.max(0, target));
      render();
    }

    /* ── Play / pause ───────────────────────────────────────────────── */

    function setPlaying(on: boolean) {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
      if (on) {
        timer = window.setInterval(() => {
          if (!step(1)) setPlaying(false);
        }, speedMs);
      }
      playBtn?.setAttribute('aria-pressed', String(on));
      playBtn?.setAttribute(
        'aria-label',
        on ? 'Pause evolution' : 'Play evolution'
      );
      root.querySelector('[data-icon="play"]')?.classList.toggle('hidden', on);
      root
        .querySelector('[data-icon="pause"]')
        ?.classList.toggle('hidden', !on);
    }

    const isPlaying = () => timer !== null;

    /* ── Wiring ─────────────────────────────────────────────────────── */

    playBtn?.addEventListener('click', () => {
      // Restarting from the end should replay rather than sit still.
      if (!isPlaying() && index >= frames.length - 1) {
        seek(playable[0] ?? 0);
      }
      setPlaying(!isPlaying());
    });
    prevBtn?.addEventListener('click', () => {
      setPlaying(false);
      step(-1);
    });
    nextBtn?.addEventListener('click', () => {
      setPlaying(false);
      step(1);
    });

    scrubber?.addEventListener('input', () => {
      setPlaying(false);
      seek(Number(scrubber.value));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-speed]').forEach((btn) => {
      btn.addEventListener('click', () => {
        speedMs = Number(btn.dataset.speed) || 2000;
        root
          .querySelectorAll<HTMLButtonElement>('[data-speed]')
          .forEach((b) => {
            const on = b === btn;
            b.setAttribute('aria-pressed', String(on));
            b.classList.toggle('bg-neutral-900', on);
            b.classList.toggle('text-white', on);
            b.classList.toggle('dark:bg-white', on);
            b.classList.toggle('dark:text-neutral-900', on);
          });
        if (isPlaying()) setPlaying(true); // restart the timer at the new rate
      });
    });

    // Filmstrip items stay real links until playback is ready; once it is,
    // clicking one seeks instead of navigating away.
    filmItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        if (frames.length === 0) return; // not ready — let the link work
        e.preventDefault();
        setPlaying(false);
        seek(Number(item.dataset.index));
      });
    });

    document.addEventListener('keydown', (e) => {
      // Never steal keys from a form control or another interactive element.
      const target = e.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.tagName === 'SELECT' ||
          target.isContentEditable)
      ) {
        return;
      }
      if (frames.length === 0) return;

      if (e.key === ' ' || e.key === 'k') {
        e.preventDefault();
        setPlaying(!isPlaying());
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        setPlaying(false);
        step(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        setPlaying(false);
        step(-1);
      }
    });

    // Pause when the tab is hidden — a background timer swapping iframes is
    // pure waste, and it keeps hammering the archive.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && isPlaying()) setPlaying(false);
    });

    /* ── Load ───────────────────────────────────────────────────────── */

    async function load() {
      const domain = root.dataset.domain ?? '';
      const count = root.dataset.frames ?? '16';
      showStatus(
        'Preparing the evolution…',
        'Looking up representative snapshots across the archive. This takes a moment the first time.',
        false
      );

      try {
        const res = await fetch(
          `/api/evolution?url=${encodeURIComponent(domain)}&frames=${encodeURIComponent(count)}`
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = (await res.json()) as EvolutionPayload;

        if (data.status !== 'ok' || !data.frames?.length) {
          showStatus(
            'Evolution unavailable',
            data.message ??
              'We could not assemble an evolution for this website.',
            true
          );
          return;
        }

        frames = data.frames;
        playable = frames
          .map((f, i) => (f.available ? i : -1))
          .filter((i) => i !== -1);

        if (playable.length === 0) {
          showStatus(
            'No playable snapshots',
            'The Internet Archive lists captures for this site, but none of them could be loaded right now.',
            true
          );
          return;
        }

        if (scrubber) {
          scrubber.max = String(frames.length - 1);
          scrubber.disabled = false;
        }
        [playBtn, prevBtn, nextBtn].forEach((b) => {
          if (b) b.disabled = false;
        });

        index = playable[0];
        render();
        hideStatus();
      } catch {
        showStatus(
          'Could not load the evolution',
          'The request to the Internet Archive failed. It may be busy — try again in a moment.',
          true
        );
      }
    }

    statusRetry?.addEventListener('click', () => void load());
    void load();
  }

  document
    .querySelectorAll<HTMLElement>('[data-evolution]')
    .forEach(initPlayer);
</script>
