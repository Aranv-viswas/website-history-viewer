---
/**
 * Analytics — product event tracking on top of the existing Google tag.
 *
 * Two deliberate constraints:
 *
 * 1. **Nothing new is loaded.** The Google tag is already in <head>; this only
 *    adds `gtag('event', …)` calls on top of it. No second vendor, no extra
 *    request, no cookies beyond the ones already there.
 *
 * 2. **No personal data, ever.** Events carry only what the product needs to
 *    understand itself: which feature was used, and for a public domain, which
 *    one. Never the referrer chain, never anything typed into a field except a
 *    domain the user asked us to look up (which is the action itself, and is
 *    already in the URL). If gtag is absent — blocked, or not yet loaded — the
 *    helper is a silent no-op rather than an error.
 *
 * Usage. Declarative, for anything clickable:
 *
 *   <a href="…" data-track="collection_opened" data-track-label="early-internet">
 *
 * Or imperatively from a component script:
 *
 *   window.whvTrack?.('evolution_played', { domain: 'google.com' });
 */
---

<script>
  /**
   * Forward a product event to the Google tag, if one is present.
   * Silently does nothing when analytics is blocked or not loaded.
   */
  interface TrackParams {
    [key: string]: string | number | boolean | undefined;
  }

  function track(event: string, params: TrackParams = {}): void {
    try {
      const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void })
        .gtag;
      if (typeof gtag !== 'function') return;

      // Drop undefined values so the payload stays clean and predictable.
      const clean: TrackParams = {};
      for (const [key, value] of Object.entries(params)) {
        if (value !== undefined && value !== '') clean[key] = value;
      }
      gtag('event', event, clean);
    } catch {
      // Analytics must never break a page.
    }
  }

  // Expose for component scripts (the evolution player, the timeline, …).
  (window as unknown as { whvTrack: typeof track }).whvTrack = track;

  /**
   * Declarative tracking: one delegated listener covers every `data-track`
   * element on the page, including ones added later by client scripts.
   */
  document.addEventListener(
    'click',
    (e) => {
      const el = (e.target as Element)?.closest?.<HTMLElement>('[data-track]');
      if (!el) return;
      track(el.dataset.track ?? 'unknown', {
        label: el.dataset.trackLabel,
        domain: el.dataset.trackDomain,
      });
    },
    // Capture, so an event is still recorded when a handler further down
    // calls stopPropagation (the filmstrip's seek handler does exactly that).
    true
  );

  /**
   * Page-level events that don't correspond to a click. Derived from the URL,
   * so they're recorded whether the visitor arrived by navigating or by opening
   * a shared link — which is the more interesting case for these features.
   */
  const path = window.location.pathname;
  const segments = path.split('/').filter(Boolean);

  if (segments[0] === 'site' && segments[1]) {
    track('snapshot_opened', { domain: segments[1], date: segments[2] });
  } else if (segments[0] === 'compare' && segments[1]) {
    track('comparison_viewed', {
      domain: segments[1],
      from: segments[2],
      to: segments[3],
    });
  } else if (segments[0] === 'timeline' && segments[1]) {
    track('timeline_viewed', { domain: segments[1] });
  } else if (segments[0] === 'evolution' && segments[1]) {
    track('evolution_viewed', { domain: segments[1] });
  } else if (segments[0] === 'design' && segments[1]) {
    track('design_history_viewed', { domain: segments[1] });
  } else if (segments[0] === 'collection' && segments[1]) {
    track('collection_opened', { label: segments[1] });
  } else if (segments[0] === 'report' && segments[1]) {
    track('report_opened', { domain: segments[1] });
  } else if (path === '/on-this-day') {
    track('on_this_day_viewed');
  } else if (path.endsWith('/explore') || path.endsWith('/explore/')) {
    track('explore_viewed');
  }
</script>
