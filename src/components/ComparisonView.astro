---
/**
 * ComparisonView — two snapshots of one website, side by side or under a
 * draggable before/after divider.
 *
 * Notes on the two modes:
 *
 * - **Mode switching is pure CSS.** Two named `peer` radios drive it, so
 *   flipping between views costs no JavaScript and survives a failed script.
 *
 * - **The slider is a real slider.** The handle carries `role="slider"` with
 *   the ARIA value attributes, so it's announced and operable from the
 *   keyboard; dragging is Pointer Events, which covers mouse, touch and pen in
 *   one code path and — via `setPointerCapture` — keeps tracking when the
 *   pointer leaves the element mid-drag. Position is written to a `--pos`
 *   custom property that a `clip-path` reads, so dragging never triggers
 *   layout: the browser only re-rasterizes the clip.
 *
 * - **Previews are inert.** Each side is an <iframe> onto web.archive.org with
 *   `pointer-events: none`, so a drag across the divider is a drag, not a click
 *   into an archived page that then swallows the gesture.
 */
import type { ComparisonResult } from '@lib/types';
import ScreenshotFrame from '@components/ScreenshotFrame.astro';
import FullscreenSupport from '@components/FullscreenSupport.astro';
import { placeholderPoster } from '@services/screenshot';

interface Props {
  result: ComparisonResult;
  labelA: string;
  labelB: string;
  /** Which mode opens first. */
  initialMode?: 'side' | 'slider';
}

const { result, labelA, labelB, initialMode = 'side' } = Astro.props;
const { a, b } = result;

const posterA = placeholderPoster(
  labelA,
  a.screenshot.width,
  a.screenshot.height
);
const posterB = placeholderPoster(
  labelB,
  b.screenshot.width,
  b.screenshot.height
);

const bothAvailable = a.snapshot.available && b.snapshot.available;
---

<div>
  {/* Mode switch (pure CSS via named peers) */}
  <input
    type="radio"
    name="cmp-mode"
    id="cmp-side"
    class="peer/side sr-only"
    checked={initialMode === 'side'}
  />
  <input
    type="radio"
    name="cmp-mode"
    id="cmp-slide"
    class="peer/slide sr-only"
    checked={initialMode === 'slider'}
  />

  <div
    class="mb-5 inline-flex rounded-full border border-neutral-200 p-1 dark:border-neutral-800"
    role="group"
    aria-label="Comparison mode"
  >
    <label
      for="cmp-side"
      class="cursor-pointer rounded-full px-4 py-1.5 text-sm font-medium text-neutral-600 peer-checked/side:bg-neutral-900 peer-checked/side:text-white dark:text-neutral-300 dark:peer-checked/side:bg-white dark:peer-checked/side:text-neutral-900"
      >Side by side</label
    >
    <label
      for="cmp-slide"
      class="cursor-pointer rounded-full px-4 py-1.5 text-sm font-medium text-neutral-600 peer-checked/slide:bg-neutral-900 peer-checked/slide:text-white dark:text-neutral-300 dark:peer-checked/slide:bg-white dark:peer-checked/slide:text-neutral-900"
      >Before / after slider</label
    >
  </div>

  {/* ---- Side-by-side mode ---- */}
  <div class="hidden grid-cols-1 gap-6 peer-checked/side:grid md:grid-cols-2">
    <div>
      <h3
        class="mb-2 text-center text-sm font-semibold text-neutral-700 dark:text-neutral-300"
      >
        {labelA}
      </h3>
      <ScreenshotFrame
        snapshot={a.snapshot}
        screenshot={a.screenshot}
        label={labelA}
        loading="eager"
        aspectClass="aspect-[16/10]"
      />
    </div>
    <div>
      <h3
        class="mb-2 text-center text-sm font-semibold text-neutral-700 dark:text-neutral-300"
      >
        {labelB}
      </h3>
      <ScreenshotFrame
        snapshot={b.snapshot}
        screenshot={b.screenshot}
        label={labelB}
        loading="eager"
        aspectClass="aspect-[16/10]"
      />
    </div>
  </div>

  {/* ---- Slider mode ---- */}
  <div class="hidden peer-checked/slide:block">
    {
      bothAvailable ? (
        <>
          <div
            data-compare-slider
            data-fullscreen-target
            class="group relative aspect-[16/10] w-full touch-pan-y overflow-hidden rounded-xl border border-neutral-200 select-none dark:border-neutral-800"
            style="--pos:50%"
          >
            {/* Bottom layer: B ("after"), always fully drawn. */}
            <div class="absolute inset-0">
              {b.screenshot.imageUrl ? (
                <img
                  src={b.screenshot.imageUrl}
                  alt={b.screenshot.alt}
                  class="pointer-events-none h-full w-full object-cover object-top"
                />
              ) : b.screenshot.iframeUrl ? (
                <iframe
                  src={b.screenshot.iframeUrl}
                  title={`Archived ${labelB}`}
                  referrerpolicy="no-referrer"
                  sandbox="allow-scripts allow-same-origin"
                  style={`background-image:url("${posterB}");background-size:cover;pointer-events:none;`}
                  class="h-full w-full border-0 bg-white"
                />
              ) : (
                <img
                  src={posterB}
                  alt={b.screenshot.alt}
                  class="h-full w-full object-cover"
                />
              )}
            </div>

            {/* Top layer: A ("before"), clipped to the divider position. */}
            <div
              data-compare-clip
              class="absolute inset-0"
              style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)"
            >
              {a.screenshot.imageUrl ? (
                <img
                  src={a.screenshot.imageUrl}
                  alt={a.screenshot.alt}
                  class="pointer-events-none h-full w-full object-cover object-top"
                />
              ) : a.screenshot.iframeUrl ? (
                <iframe
                  src={a.screenshot.iframeUrl}
                  title={`Archived ${labelA}`}
                  referrerpolicy="no-referrer"
                  sandbox="allow-scripts allow-same-origin"
                  style={`background-image:url("${posterA}");background-size:cover;pointer-events:none;`}
                  class="h-full w-full border-0 bg-white"
                />
              ) : (
                <img
                  src={posterA}
                  alt={a.screenshot.alt}
                  class="h-full w-full object-cover"
                />
              )}
            </div>

            {/* Date labels. The "before" one is clipped along with its layer so
                it disappears when the divider is dragged fully left. */}
            <span
              data-compare-label="a"
              class="pointer-events-none absolute top-2 left-2 z-10 rounded bg-black/65 px-2 py-0.5 text-xs font-medium text-white backdrop-blur-sm"
            >
              {labelA}
            </span>
            <span
              data-compare-label="b"
              class="pointer-events-none absolute top-2 right-2 z-10 rounded bg-black/65 px-2 py-0.5 text-xs font-medium text-white backdrop-blur-sm"
            >
              {labelB}
            </span>

            {/* Divider + handle. The handle is the accessible slider. */}
            <div
              class="pointer-events-none absolute inset-y-0 z-20 w-0.5 -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.25)]"
              style="left: var(--pos)"
              aria-hidden="true"
            />
            <button
              type="button"
              data-compare-handle
              role="slider"
              aria-label={`Reveal ${labelA} or ${labelB}`}
              aria-orientation="horizontal"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="50"
              aria-valuetext={`50% — showing ${labelA} on the left, ${labelB} on the right`}
              class="absolute top-1/2 z-30 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize touch-none items-center justify-center rounded-full bg-white text-neutral-700 shadow-float transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 active:scale-95"
              style="left: var(--pos)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-5 w-5"
                aria-hidden="true"
              >
                <path d="M8 7 3 12l5 5V7zm8 0v10l5-5-5-5z" />
              </svg>
            </button>

            {/* Fullscreen toggle. */}
            <button
              type="button"
              data-fullscreen-btn
              title="View fullscreen"
              aria-label="View fullscreen"
              class="absolute right-2 bottom-2 z-30 rounded-md bg-black/55 p-1.5 text-white opacity-0 backdrop-blur-sm transition group-hover:opacity-100 hover:bg-black/75 focus:opacity-100 focus-visible:outline-none"
            >
              <svg
                data-fs-icon="enter"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3" />
              </svg>
              <svg
                data-fs-icon="exit"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden h-4 w-4"
                aria-hidden="true"
              >
                <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3" />
              </svg>
            </button>
          </div>

          <p class="mt-2 text-center text-xs text-neutral-500">
            Drag the handle to reveal {labelA} on the left and {labelB} on the
            right. Arrow keys nudge it; Home and End jump to either edge.
          </p>
        </>
      ) : (
        <p class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
          The slider needs an available snapshot on both dates, and{' '}
          {!a.snapshot.available && !b.snapshot.available
            ? 'neither date has one'
            : !a.snapshot.available
              ? `${labelA} has none`
              : `${labelB} has none`}
          . Try the side-by-side view, or pick different dates.
        </p>
      )
    }
  </div>
</div>

<FullscreenSupport />

<script>
  /**
   * Before/after divider dragging.
   *
   * One controller per slider on the page. Pointer Events cover mouse, touch
   * and pen together, and pointer capture means a fast drag that outruns the
   * cursor still tracks correctly instead of dropping the gesture.
   */
  function initCompareSlider(root: HTMLElement) {
    const handle = root.querySelector<HTMLElement>('[data-compare-handle]');
    const labelA = root.querySelector<HTMLElement>('[data-compare-label="a"]');
    if (!handle) return;

    const valueTextBase = handle.getAttribute('aria-label') ?? '';
    let position = 50;

    function apply(next: number) {
      position = Math.min(100, Math.max(0, next));
      root.style.setProperty('--pos', `${position}%`);
      handle!.setAttribute('aria-valuenow', String(Math.round(position)));
      handle!.setAttribute(
        'aria-valuetext',
        `${Math.round(position)}% — ${valueTextBase}`
      );
      // Fade the "before" caption out as its layer is clipped away, so it never
      // floats over a region it no longer describes.
      if (labelA) labelA.style.opacity = position < 12 ? '0' : '1';
    }

    /** Map a clientX to a percentage across the slider. */
    function positionFor(clientX: number): number {
      const box = root.getBoundingClientRect();
      if (box.width === 0) return position;
      return ((clientX - box.left) / box.width) * 100;
    }

    let dragging = false;

    function onPointerDown(e: PointerEvent) {
      // Ignore secondary buttons and the fullscreen control.
      if (e.button !== 0) return;
      if ((e.target as Element)?.closest?.('[data-fullscreen-btn]')) return;

      dragging = true;
      root.classList.add('cursor-ew-resize');
      // Capture on the handle so movement outside the element still tracks.
      handle!.setPointerCapture?.(e.pointerId);
      apply(positionFor(e.clientX));
      e.preventDefault();
    }

    function onPointerMove(e: PointerEvent) {
      if (!dragging) return;
      apply(positionFor(e.clientX));
      e.preventDefault();
    }

    function onPointerUp(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('cursor-ew-resize');
      handle!.releasePointerCapture?.(e.pointerId);
    }

    // Pressing anywhere on the frame starts a drag from that point, which is
    // what people expect from a before/after control.
    root.addEventListener('pointerdown', onPointerDown);
    handle.addEventListener('pointermove', onPointerMove);
    root.addEventListener('pointermove', onPointerMove);
    handle.addEventListener('pointerup', onPointerUp);
    root.addEventListener('pointerup', onPointerUp);
    handle.addEventListener('pointercancel', onPointerUp);
    root.addEventListener('pointercancel', onPointerUp);

    handle.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 2;
      let handled = true;
      switch (e.key) {
        case 'ArrowLeft':
        case 'ArrowDown':
          apply(position - step);
          break;
        case 'ArrowRight':
        case 'ArrowUp':
          apply(position + step);
          break;
        case 'Home':
          apply(0);
          break;
        case 'End':
          apply(100);
          break;
        case 'PageDown':
          apply(position - 20);
          break;
        case 'PageUp':
          apply(position + 20);
          break;
        default:
          handled = false;
      }
      if (handled) e.preventDefault();
    });

    apply(50);
  }

  document
    .querySelectorAll<HTMLElement>('[data-compare-slider]')
    .forEach(initCompareSlider);
</script>
