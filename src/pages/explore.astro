---
/**
 * GET /explore — search for a website and see what the archive holds for it.
 *
 * Honest scope note, because it shapes the whole design: the Internet Archive
 * has no "search for a website by name" API. What it can answer is "what do you
 * hold for this exact host". So this page does two things side by side:
 *
 *   1. **Lookup.** Whatever is typed is normalized to a host ("Google" ->
 *      google.com) and looked up live against /api/stats, debounced. The result
 *      is real data: first and latest archived year, span, capture count.
 *
 *   2. **Suggestions.** The curated collection roster is rendered into the page
 *      and filtered client-side as you type. No request, instant, and it gives
 *      the query somewhere to go when the typed host has nothing.
 *
 * Prerendered — the shell is static and the live part is a fetch, so this costs
 * nothing to serve and works in every locale.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { allCollectionSites, COLLECTIONS } from '@lib/collections';
import { domainToSlug } from '@utils/domain';
import { breadcrumbJsonLd } from '@lib/seo';
import { getLang, localizeHref } from '@i18n/utils';

export const prerender = true;

const lang = getLang(Astro);
const L = (path: string) => localizeHref(path, lang);

const suggestions = allCollectionSites().sort((a, b) =>
  a.name.localeCompare(b.name)
);

const title = 'Explore Website Histories — Search Any Domain';
const description =
  'Search any website and see what the Internet Archive holds for it: the first and latest archived snapshot, how many years of history exist, and how many captures were made.';

const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore' },
]);
---

<BaseLayout title={title} description={description} jsonLd={breadcrumb}>
  <div class="container-page py-12">
    <header class="mx-auto mb-8 max-w-2xl text-center">
      <p class="eyebrow">Explore</p>
      <h1
        class="mt-2 text-3xl font-semibold tracking-tighter text-neutral-900 sm:text-4xl dark:text-neutral-50"
      >
        Search any website's history
      </h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">
        Type a domain to see what the Internet Archive has kept — how far back
        it goes, how much of it survives, and where to start looking.
      </p>
    </header>

    {/* ── Search ──────────────────────────────────────────────────────── */}
    <div class="mx-auto max-w-2xl">
      {
        /* A real form so pressing Enter works with no JavaScript: it falls
          through to /search, which redirects to the snapshot viewer. */
      }
      <form
        action="/search"
        method="get"
        data-explore-form
        class="card p-4 sm:p-5"
      >
        <label class="label" for="explore-q">Website or domain</label>
        <div class="flex gap-2">
          <input
            id="explore-q"
            name="domain"
            type="text"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
            required
            placeholder="google.com, apple.com, geocities.com…"
            class="input text-base"
            aria-describedby="explore-hint"
            aria-controls="explore-result"
          />
          <button type="submit" class="btn-primary shrink-0">Search</button>
        </div>
        <p id="explore-hint" class="mt-2 text-xs text-neutral-500">
          Bare words are treated as .com — typing “google” looks up google.com.
        </p>
      </form>

      {/* Live result. Populated by the client; empty and hidden until then. */}
      <div
        id="explore-result"
        data-explore-result
        role="status"
        aria-live="polite"
        class="mt-4 hidden"
      >
      </div>
    </div>

    {/* ── Suggestions ─────────────────────────────────────────────────── */}
    <section class="mt-16" aria-labelledby="suggestions-heading">
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
        <h2
          id="suggestions-heading"
          class="text-xl font-semibold text-neutral-900 dark:text-neutral-100"
        >
          Websites with histories worth exploring
        </h2>
        <p data-suggestion-count class="text-sm text-neutral-500">
          {suggestions.length} curated sites
        </p>
      </div>

      <ul
        data-suggestions
        class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
      >
        {
          suggestions.map((site) => {
            const slug = domainToSlug(site.domain);
            return (
              <li
                data-suggestion
                data-name={site.name.toLowerCase()}
                data-domain={site.domain.toLowerCase()}
              >
                <a
                  href={`/timeline/${slug}`}
                  class="card flex h-full flex-col p-4 transition hover:border-neutral-300 hover:shadow-card-hover dark:hover:border-neutral-700"
                >
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
                      {site.name}
                    </h3>
                    <span class="font-mono text-[11px] text-neutral-500">
                      {site.year}
                    </span>
                  </div>
                  <p class="font-mono text-[11px] text-neutral-500">
                    {site.domain}
                  </p>
                  <p class="mt-2 flex-1 text-xs text-neutral-600 dark:text-neutral-400">
                    {site.note}
                  </p>
                  <span class="mt-3 text-xs font-medium text-brand-600 dark:text-brand-400">
                    View timeline →
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <p
        data-suggestions-empty
        class="hidden rounded-xl border border-dashed border-neutral-300 p-8 text-center text-sm text-neutral-500 dark:border-neutral-700"
      >
        No curated site matches that. The live lookup above still works for any
        domain.
      </p>
    </section>

    {/* ── Collections ─────────────────────────────────────────────────── */}
    <section class="mt-16">
      <h2
        class="mb-5 text-xl font-semibold text-neutral-900 dark:text-neutral-100"
      >
        Or browse by theme
      </h2>
      <div class="flex flex-wrap gap-2">
        {
          COLLECTIONS.map((collection) => (
            <a
              href={L(`/collection/${collection.slug}`)}
              class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-800 transition hover:border-neutral-300 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200"
            >
              <span aria-hidden="true">{collection.emoji}</span>
              {collection.title}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * Live domain lookup + client-side suggestion filtering.
   *
   * The lookup is debounced and single-flight: only the most recent query's
   * response is ever rendered, so a fast typist can't have an early, slower
   * response overwrite a later one.
   */
  const DEBOUNCE_MS = 400;
  const MIN_LENGTH = 3;

  interface StatsPayload {
    domain: string;
    name: string;
    status: string;
    message: string | null;
    firstYear: number | null;
    lastYear: number | null;
    yearsSpanned: number;
    totalCaptures: number;
    previewDate: string | null;
    links: { timeline: string; evolution: string; snapshot: string | null };
  }

  const form = document.querySelector<HTMLFormElement>('[data-explore-form]');
  const input = document.getElementById('explore-q') as HTMLInputElement | null;
  const result = document.querySelector<HTMLElement>('[data-explore-result]');
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('[data-suggestion]')
  );
  const emptyNote = document.querySelector<HTMLElement>(
    '[data-suggestions-empty]'
  );
  const countNote = document.querySelector<HTMLElement>(
    '[data-suggestion-count]'
  );

  if (!input || !result) {
    // Nothing to enhance — the plain form still works.
  } else {
    let timer: number | undefined;
    /** Increments per request; a response only renders if it's still current. */
    let generation = 0;
    let lastQuery = '';

    const escapeHtml = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (c) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          })[c] ?? c
      );

    function show(html: string) {
      result!.innerHTML = html;
      result!.classList.remove('hidden');
    }

    function hide() {
      result!.classList.add('hidden');
      result!.innerHTML = '';
    }

    function renderLoading(query: string) {
      show(
        `<div class="card flex items-center gap-3 p-4">
           <div class="h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-neutral-300 border-t-brand-600 dark:border-neutral-700 dark:border-t-brand-400"></div>
           <p class="text-sm text-neutral-600 dark:text-neutral-400">Checking the archive for <span class="font-mono">${escapeHtml(query)}</span>…</p>
         </div>`
      );
    }

    function renderResult(data: StatsPayload) {
      if (data.status !== 'ok') {
        const icon = data.status === 'blocked' ? '🚫' : '🗄️';
        show(
          `<div class="card p-5">
             <p class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-300">
               <span aria-hidden="true" class="text-lg leading-none">${icon}</span>
               <span>${escapeHtml(data.message ?? 'No archived history found for this website.')}</span>
             </p>
           </div>`
        );
        return;
      }

      const captures = data.totalCaptures.toLocaleString('en-US');
      show(
        `<div class="card p-5">
           <div class="flex flex-wrap items-baseline justify-between gap-2">
             <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">${escapeHtml(data.name)}</h2>
             <p class="font-mono text-xs text-neutral-500">${escapeHtml(data.domain)}</p>
           </div>
           <dl class="mt-4 grid grid-cols-3 gap-3 text-center">
             <div>
               <dt class="text-[11px] font-medium text-neutral-500">First archived</dt>
               <dd class="text-xl font-semibold tabular-nums text-neutral-900 dark:text-neutral-100">${data.firstYear ?? '—'}</dd>
             </div>
             <div>
               <dt class="text-[11px] font-medium text-neutral-500">Latest archived</dt>
               <dd class="text-xl font-semibold tabular-nums text-neutral-900 dark:text-neutral-100">${data.lastYear ?? '—'}</dd>
             </div>
             <div>
               <dt class="text-[11px] font-medium text-neutral-500">Captures</dt>
               <dd class="text-xl font-semibold tabular-nums text-neutral-900 dark:text-neutral-100">${captures}</dd>
             </div>
           </dl>
           <div class="mt-5 flex flex-wrap gap-2">
             <a href="${escapeHtml(data.links.timeline)}" class="btn-primary !px-4 !py-2 !text-sm">📅 View timeline</a>
             <a href="${escapeHtml(data.links.evolution)}" class="btn-secondary !px-4 !py-2 !text-sm">▶ Play evolution</a>
             ${
               data.links.snapshot
                 ? `<a href="${escapeHtml(data.links.snapshot)}" class="btn-secondary !px-4 !py-2 !text-sm">🖼 Open a snapshot</a>`
                 : ''
             }
           </div>
           <p class="mt-3 text-xs text-neutral-500">
             ${data.yearsSpanned} years of archived history, as held by the Internet Archive.
           </p>
         </div>`
      );
    }

    async function lookup(query: string) {
      const mine = ++generation;
      renderLoading(query);
      try {
        const res = await fetch(`/api/stats?url=${encodeURIComponent(query)}`);
        if (mine !== generation) return; // a newer query has taken over
        if (!res.ok) {
          if (res.status === 400) {
            show(
              `<div class="card p-4 text-sm text-neutral-600 dark:text-neutral-400">That doesn't look like a website address yet — keep typing.</div>`
            );
            return;
          }
          throw new Error(`HTTP ${res.status}`);
        }
        const data = (await res.json()) as StatsPayload;
        if (mine !== generation) return;
        renderResult(data);
      } catch {
        if (mine !== generation) return;
        show(
          `<div class="card p-4 text-sm text-neutral-600 dark:text-neutral-400">We couldn't reach the Internet Archive just now. Press Search to try again.</div>`
        );
      }
    }

    function filterSuggestions(query: string) {
      const q = query.trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const match =
          q.length === 0 ||
          (item.dataset.name ?? '').includes(q) ||
          (item.dataset.domain ?? '').includes(q);
        item.classList.toggle('hidden', !match);
        if (match) visible += 1;
      }
      emptyNote?.classList.toggle('hidden', visible > 0);
      if (countNote) {
        countNote.textContent =
          q.length === 0
            ? `${items.length} curated sites`
            : `${visible} of ${items.length} curated sites`;
      }
    }

    input.addEventListener('input', () => {
      const query = input.value.trim();
      filterSuggestions(query);

      window.clearTimeout(timer);
      if (query.length < MIN_LENGTH) {
        generation += 1; // cancel any in-flight render
        hide();
        return;
      }
      if (query === lastQuery) return;

      timer = window.setTimeout(() => {
        lastQuery = query;
        void lookup(query);
      }, DEBOUNCE_MS);
    });

    // Submitting runs the lookup in place rather than navigating away, so the
    // result appears without losing the typed query.
    form?.addEventListener('submit', (e) => {
      const query = input.value.trim();
      if (query.length < MIN_LENGTH) return; // let the browser validate
      e.preventDefault();
      window.clearTimeout(timer);
      lastQuery = query;
      void lookup(query);
    });
  }
</script>
